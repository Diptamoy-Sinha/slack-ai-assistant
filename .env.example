# Config source: omit or "local" for .env; set CONFIG_SOURCE=aws in AWS with APP_SECRETS_ARN.
# CONFIG_SOURCE=local

# Logging: hook logs use logger "agent.hooks". Set LOG_LEVEL=DEBUG to see everything.
# LOG_LEVEL=INFO
# AGENT_LOG_FILE=logs/agent.log

# Optional, uncomment and set when running without the Slack CLI (python3 app.py).
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Optional, uncomment and set when using a custom Slack instance.
# SLACK_API_URL=YOUR_SLACK_API_URL

# Required, set your OpenAI API key.
OPENAI_API_KEY=
# Required for Strands agent web search.
TAVILY_API_KEY=

# Required for Strands agent session persistence (copy from strands_agent_tuto if needed).
S3_SESSION_BUCKET=agenttutorial
S3_SESSION_PREFIX=sessions
AWS_REGION=us-east-1
# Use "file" for local dev (no AWS). Use "s3" when AWS credentials are configured.
SESSION_BACKEND=file
